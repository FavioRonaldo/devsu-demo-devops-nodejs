{
  "name": "demo-devops-nodejs",
  "version": "1.0.0",
  "description": "Users REST API used in the Devsu DevOps technical test",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint ."
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "app.js",
      "shared/**/*.js",
      "users/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "author": "Devsu",
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "sqlite3": "6.0.1",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.17",
    "babel-jest": "29.7.0",
    "eslint": "10.12.0",
    "eslint-plugin-jest": "29.16.6",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "supertest": "7.3.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
